{
  "name": "epiflora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Multimodal, voice-first agricultural intelligence platform for smallholder farmers across BRICS nations.",
  "scripts": {
    "dev": "concurrently -n web,api -c green,cyan \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/dev.ts",
    "build": "tsc -b && vite build",
    "preflight": "tsx scripts/preflight.ts",
    "smoke": "tsx scripts/smoke.ts",
    "chain:test": "tsx scripts/chain-test.ts",
    "voice:test": "tsx scripts/voice-test.ts",
    "voice:fallback": "tsx scripts/voice-fallback-test.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "predeploy": "GITHUB_PAGES=true npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "gsap": "^3.15.0",
    "hono": "4.13.2",
    "lenis": "^1.3.26",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "three": "^0.185.1",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.5",
    "gh-pages": "^6.3.0",
    "puppeteer": "^25.8.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
